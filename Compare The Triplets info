  ↓
3 < 3 ? NO
  ↓
Loop ends
  ↓
scores.add(1)
  ↓
scores.add(1)
  ↓
scores = [1, 1]
  ↓
return scores
  ↓
Back to main()
  ↓
result = [1, 1]
